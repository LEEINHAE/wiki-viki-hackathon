		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.6",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@xmldom/xmldom": "^0.8.15",
		"diff": "^9.0.0",
		"jszip": "^3.10.2",
